<?xml version="1.0" encoding="utf-8"?>
<View>
	
	<Panel Anchor="$CenterX,$CenterY" Bounds="-161,60,322,118" InnerMargin="10,6,8,10">
		<CrawlText Name="Description" Text="Bind Description" Alignment="Stretch" Font="Dialogue"/>
	</Panel>

	<Panel InnerMargin="0,1,0,0" Anchor="$CenterX,$CenterY" Bounds="Bind LabelBounds" Style="MagicPopup" Visible="Bind ShowLabel">
		<Label Text="Bind Label" Font="Console" Alignment="Center" />
	</Panel>
	
</View>