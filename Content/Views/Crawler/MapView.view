<?xml version="1.0" encoding="utf-8"?>
<View>

	<Panel Style="WhitePanel" Bounds="120,11,300,37" InnerMargin="5,5,5,5" Visible="Bind ShowObjectives">
		<DataGrid Items="Bind PlayerProfile.Objectives" Bounds="0,0,290,27" Alignment="Center">
			<Panel Alignment="Vertical" Bounds="0,0,290,9">
				<Image Icon="2,2" Alignment="Left" Bounds="4,0,8,8" Color="#FFFFFFFF" Visible="Bind DataGrid.Completed"/>
				<Label Text="Bind DataGrid.Headline" Font="Console" Alignment="Left" TextAlignment="Left" Bounds="4,0,270,9"/>
			</Panel>
		</DataGrid>
	</Panel>

	<Panel Style="CrawlerFrame" Bounds="109,2,322,237" Depth="0.9">
		<Button Name="InteractLabel" Alignment="Center" InnerMargin="0,1,0,0" Bounds="Bind InteractBounds" Style="WhitePanel" Action="ActivatePrompt" Visible="Bind ShowInteractLabel">
			<Label Text="Bind InteractLabel" Font="Console" Alignment="Center" />
		</Button>
	</Panel>



	<Panel Style="BlackSquareMain" Bounds="2,240,106,118" InnerMargin="7,7,7,7" Visible="Bind HideBattleUI">
		<Button Bounds="0,0,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="StrafeLeft" >
			<Image Picture="StrafeLeft" Alignment="Vertical" Bounds="0,3,24,8" />
			<Label Text="Q" Alignment="Vertical" Bounds="1,2,8,8" />
		</Button>
		<Button Bounds="2,0,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="MoveForward" >
			<Image Picture="Forward" Alignment="Vertical" Bounds="1,3,24,8" />
			<Label Text="W" Alignment="Vertical" Bounds="1,3,8,8" />
		</Button>
		<Button Bounds="2,0,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="StrafeRight" >
			<Image Picture="StrafeRight" Alignment="Vertical" Bounds="1,3,24,8" />
			<Label Text="E" Alignment="Vertical" Bounds="1,3,8,8" />
		</Button>
		<Button Bounds="0,2,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="TurnLeft" >
			<Image Picture="TurnLeft" Alignment="Vertical" Bounds="0,3,24,8" />
			<Label Text="A" Alignment="Vertical" Bounds="1,3,8,8" />
		</Button>
		<Button Bounds="2,2,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="MoveBackward" >
			<Image Picture="Backward" Alignment="Vertical" Bounds="1,3,24,8" />
			<Label Text="S" Alignment="Vertical" Bounds="1,3,8,8" />
		</Button>
		<Button Bounds="2,2,29,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="TurnRight" >
			<Image Picture="TurnRight" Alignment="Vertical" Bounds="1,3,24,8" />
			<Label Text="D" Alignment="Vertical" Bounds="1,3,8,8" />
		</Button>

		<Button Bounds="2,4,87,29" Alignment="Cascading" Style="ThinPanel" PushedStyle="ThinPanelSelected" Margin="8,5,8,2" Action="Wait" >
			<Label Text="Wait" Font="Console" Alignment="Vertical" Bounds="1,4,8,10" />
			<Label Text="C" Alignment="Vertical" Bounds="1,0,8,8" />
		</Button>
	</Panel>
	
	<Panel Name="MiniMapPanel" Style="BlackSquareMain" Bounds="432,240,106,118" />
	<Panel Name="NarrationPanel" Style="BlackSquareMain" Bounds="109,240,322,118" />
	<Panel Name="CommandPanel" Style="BlackSquareMain" Bounds="432,2,106,237" />

	<Panel Style="BlackSquareMain" Bounds="2,2,106,237" InnerMargin="0,5,0,5" Depth="0.3">
		<DataGrid Items="Bind PlayerProfile.Party" Bounds="0,-3,96,189" Alignment="Vertical">
			<Panel Style="ThinFrame" Bounds="0,3,96,60" Alignment="Vertical" Depth="0.1">
				
				<Image Picture="Bind DataGrid.Portrait" Bounds="0,0,96,60" Depth="0.2"/>

				<Panel Alignment="Vertical" Bounds="0,1,96,10">
					<Gauge Background="HealthGauge" Minimum="0.0" Maximum="1.0" Alignment="Relative" Bounds="8,2,80,6" Color="#FFFFFF20">
						<GaugeBar Bar="HealthBar" Value="Bind DataGrid.HealthBar" Color="#FFFFFF20"/>
					</Gauge>
					<Image Icon="0,2" Alignment="Cascading" Bounds="4,1,8,8" Depth="0.05" Color="#FFFFFFFF"/>
					<Label Text="Bind DataGrid.HP" Font="Console" Alignment="Center" TextAlignment="Center" Bounds="0,0,24,10" Color="Bind DataGrid.HealthColor" Depth="0.05"/>
				</Panel>
				
				<Panel Alignment="Vertical" Bounds="0,-2,96,10">
					<Gauge Background="HealthGauge" Minimum="0.0" Maximum="1.0" Alignment="Relative" Bounds="8,2,80,6" Color="#FFFFFF20">
						<GaugeBar Bar="ManaBar" Value="Bind DataGrid.ManaBar" Color="#FFFFFF20"/>
					</Gauge>
					<Image Icon="1,2" Alignment="Cascading" Bounds="4,1,8,8" Depth="0.05" Color="#FFFFFFFF"/>
					<Label Text="Bind DataGrid.MP" Font="Console" Alignment="Center" TextAlignment="Center" Bounds="0,0,24,10" Color="Bind DataGrid.HealthColor" Depth="0.05"/>
				</Panel>

			</Panel>
		</DataGrid>
		<Panel Style="ThinFrame" Bounds="0,4,96,37" Alignment="Vertical" Depth="0.1">
			<Image Picture="Bind PlayerProfile.Mascot.Portrait" Bounds="0,0,96,37" Depth="0.2"/>
			<Panel Alignment="Vertical" Bounds="0,1,96,10">
				<Gauge Background="HealthGauge" Minimum="0.0" Maximum="1.0" Alignment="Relative" Bounds="8,2,80,6" Color="#FFFFFF20">
					<GaugeBar Bar="ManaBar" Value="Bind PlayerProfile.Mascot.ManaBar" Color="#FFFFFF20"/>
				</Gauge>
				<Image Icon="1,2" Alignment="Cascading" Bounds="4,1,8,8" Depth="0.05" Color="#FFFFFFFF"/>
				<Label Text="Bind PlayerProfile.Mascot.MP" Font="Console" Alignment="Center" TextAlignment="Center" Bounds="0,0,24,10" Depth="0.05"/>
			</Panel>
		</Panel>
	</Panel>
</View>